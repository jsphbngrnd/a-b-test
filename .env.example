# Copy to apps/dashboard/.env.local or apps/demo/.env when you need to override a default.
# Both apps run without this file.

# Shared by the dashboard API and the Astro middleware. Change it before any public deploy.
SPLITLINE_SIGNING_SECRET=splitline-dev-secret

# Dashboard
SPLITLINE_DATA_PATH=./data/splitline.json
SPLITLINE_CORS_ORIGINS=http://127.0.0.1:43124,http://localhost:43124,http://127.0.0.1:43125,http://localhost:43125

# Optional: store experiments and events in your own Supabase project.
# Apply supabase/schema.sql first, then insert an organizations row.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# Optional: push running experiment config into Vercel Edge Config on each save.
# EDGE_CONFIG=https://edge-config.vercel.com/ecfg_...
# EDGE_CONFIG_ID=ecfg_...
# VERCEL_API_TOKEN=
# VERCEL_TEAM_ID=

# Demo site
SPLITLINE_CONFIG_URL=http://127.0.0.1:43123/api/v1/config
SPLITLINE_EVENTS_URL=http://127.0.0.1:43123/api/v1/events
SPLITLINE_API_KEY=sl_test_northline_demo
SPLITLINE_ALLOW_PREVIEW=1
PUBLIC_DASHBOARD_URL=http://127.0.0.1:43123

# Sanity Studio (apps/studio). The plugin still typechecks without these.
# SANITY_STUDIO_PROJECT_ID=
# SANITY_STUDIO_DATASET=production
# SANITY_STUDIO_SPLITLINE_ORIGIN=http://127.0.0.1:43123
