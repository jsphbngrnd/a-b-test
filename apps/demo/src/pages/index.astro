---
import Experiment from "@splitline/astro/Experiment.astro";
import { getVariant, getVariantPayload, shouldTrack } from "@splitline/astro";
import { DEMO_API_KEY } from "@splitline/core";
import { Button } from "../components/ui/button";
import { Card, CardContent, CardHeader, CardTitle } from "../components/ui/card";
import { Input } from "../components/ui/input";
import { Label } from "../components/ui/label";
import Base from "../layouts/Base.astro";

const locals = Astro.locals;
const variant = getVariant(locals, "homepage-hero");
const payload = getVariantPayload(locals.splitline?.config, "homepage-hero", variant) ?? {
  headline: "Control headline",
  subhead: "This is the original version of the page.",
  cta: "Continue",
};
const dashboard = import.meta.env.PUBLIC_DASHBOARD_URL || "http://127.0.0.1:43123";
const eventsUrl = process.env.SPLITLINE_EVENTS_URL ?? "http://127.0.0.1:43123/api/v1/events";
const tracker = {
  endpoint: eventsUrl,
  apiKey: process.env.SPLITLINE_API_KEY ?? DEMO_API_KEY,
  visitorId: locals.splitline?.visitorId ?? "",
  experimentKey: "homepage-hero",
  variantKey: variant,
  track: shouldTrack(locals, "homepage-hero"),
};
---

<Base
  title="First page"
  variant={variant}
  preview={locals.splitline?.preview}
  error={locals.splitline?.error}
  visitorId={locals.splitline?.visitorId}
  experimentLabel="Homepage hero"
  dashboardUrl={`${dashboard}/experiments/exp_homepage_hero`}
>
  <script id="splitline-state" type="application/json" set:html={JSON.stringify(tracker)} />
  <main class="mx-auto grid max-w-3xl gap-6 px-4 pb-12">
    <Card>
      <CardHeader>
        <CardTitle class="text-3xl font-bold">{payload.headline}</CardTitle>
      </CardHeader>
      <CardContent class="grid gap-4">
        <p class="text-base leading-7">{payload.subhead}</p>
        <div class="flex flex-col gap-3 sm:flex-row">
          <Button href="#response" data-splitline-goal>
            {payload.cta}
          </Button>
          <Button variant="outline" href="/pricing">
            Second page
          </Button>
        </div>
        <Experiment experiment="homepage-hero" locals={locals} class="text-sm text-muted-foreground">
          <p slot="control">Showing the control variant.</p>
          <p slot="variant_b">Showing variant B.</p>
        </Experiment>
      </CardContent>
    </Card>

    <Card id="response">
      <CardHeader>
        <CardTitle class="text-2xl font-bold">Response</CardTitle>
      </CardHeader>
      <CardContent>
        <form data-splitline-form data-form-panel class="grid gap-4">
          <div class="grid gap-1.5">
            <Label htmlFor="name">Name</Label>
            <Input id="name" name="name" required />
          </div>
          <div class="grid gap-1.5">
            <Label htmlFor="email">Email</Label>
            <Input id="email" name="email" type="email" required />
          </div>
          <Button type="submit">Send</Button>
        </form>
        <div data-form-thanks hidden>
          <h2 class="text-2xl font-bold">Response recorded.</h2>
          <p class="mt-2 text-sm text-muted-foreground">This submit is stored as a form event. It is not the goal used in the significance test.</p>
        </div>
      </CardContent>
    </Card>
  </main>
</Base>
