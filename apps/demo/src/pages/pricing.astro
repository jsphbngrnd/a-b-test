---
import { getVariant, getVariantPayload, shouldTrack } from "@splitline/astro";
import { DEMO_API_KEY } from "@splitline/core";
import Base from "../layouts/Base.astro";

const locals = Astro.locals;
const variant = getVariant(locals, "pricing-cta");
const experiment = locals.splitline?.config?.experiments.find((item) => item.key === "pricing-cta");
const payload = getVariantPayload(locals.splitline?.config, "pricing-cta", variant) ?? {
  headline: "Start with one close cycle.",
  subhead: "A four-week pilot on your real entities. No migration project, and no professional-services block before the first close.",
  cta: "Start a pilot",
};
const dashboard = import.meta.env.PUBLIC_DASHBOARD_URL || "http://127.0.0.1:43123";
const tracker = {
  endpoint: process.env.SPLITLINE_EVENTS_URL ?? "http://127.0.0.1:43123/api/v1/events",
  apiKey: process.env.SPLITLINE_API_KEY ?? DEMO_API_KEY,
  visitorId: locals.splitline?.visitorId ?? "",
  experimentKey: "pricing-cta",
  variantKey: variant,
  track: shouldTrack(locals, "pricing-cta"),
};
const status = experiment?.status ?? "unknown";
---

<Base
  title="Pricing — Northline"
  variant={variant}
  preview={locals.splitline?.preview}
  error={locals.splitline?.error}
  visitorId={locals.splitline?.visitorId}
  experimentLabel={`Pricing page CTA · ${status}`}
  dashboardUrl={`${dashboard}/experiments/exp_pricing_cta`}
>
  <script id="splitline-state" type="application/json" set:html={JSON.stringify(tracker)} />
  <main class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <p class="text-sm font-medium uppercase tracking-[0.18em] text-[var(--accent)]">Pricing</p>
    <h1 class="mt-4 max-w-2xl font-serif text-5xl leading-tight">{payload.headline}</h1>
    <p class="mt-5 max-w-2xl text-lg leading-8 text-mist">{payload.subhead}</p>
    {status === "paused" && !variant ? (
      <p class="mt-4 max-w-2xl text-sm text-mist">This experiment is paused, so new visitors see the control and are not counted. People who were already assigned keep their version.</p>
    ) : null}
    <div class="mt-10 grid gap-4 md:grid-cols-3">
      <article class="rounded-3xl border border-line p-6">
        <h2 class="font-serif text-2xl">Pilot</h2>
        <p class="mt-2 text-3xl">$0</p>
        <p class="mt-3 text-sm leading-6 text-mist">One close cycle, up to three entities. You leave with the checklist and the ties-out, whether or not you stay.</p>
      </article>
      <article class="rounded-3xl border border-[var(--accent)] bg-panel p-6">
        <h2 class="font-serif text-2xl">Team</h2>
        <p class="mt-2 text-3xl">$1,800<span class="text-base text-mist">/mo</span></p>
        <p class="mt-3 text-sm leading-6 text-mist">Unlimited entities for one finance team. Commentary, calendar, and the audit trail.</p>
      </article>
      <article class="rounded-3xl border border-line p-6">
        <h2 class="font-serif text-2xl">Group</h2>
        <p class="mt-2 text-3xl">Talk</p>
        <p class="mt-3 text-sm leading-6 text-mist">Shared close standards across several companies. We’ll scope it from the entities you already file.</p>
      </article>
    </div>
    <a data-splitline-goal href="/#walkthrough" class="mt-8 inline-flex rounded-full bg-[var(--accent)] px-5 py-3 font-medium text-ink">{payload.cta}</a>
  </main>
</Base>
