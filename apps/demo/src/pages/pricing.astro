---
import { getVariant, getVariantPayload, shouldTrack } from "@splitline/astro";
import { DEMO_API_KEY } from "@splitline/core";
import { Button } from "../components/ui/button";
import { Card, CardContent, CardHeader, CardTitle } from "../components/ui/card";
import Base from "../layouts/Base.astro";

const locals = Astro.locals;
const variant = getVariant(locals, "pricing-cta");
const experiment = locals.splitline?.config?.experiments.find((item) => item.key === "pricing-cta");
const payload = getVariantPayload(locals.splitline?.config, "pricing-cta", variant) ?? {
  headline: "Control call to action",
  subhead: "The original button label on this page.",
  cta: "Choose control",
};
const dashboard = import.meta.env.PUBLIC_DASHBOARD_URL || "http://127.0.0.1:43123";
const tracker = {
  endpoint: process.env.SPLITLINE_EVENTS_URL ?? "http://127.0.0.1:43123/api/v1/events",
  apiKey: process.env.SPLITLINE_API_KEY ?? DEMO_API_KEY,
  visitorId: locals.splitline?.visitorId ?? "",
  experimentKey: "pricing-cta",
  variantKey: variant,
  track: shouldTrack(locals, "pricing-cta"),
};
const status = experiment?.status ?? "unknown";
---

<Base
  title="Second page"
  variant={variant}
  preview={locals.splitline?.preview}
  error={locals.splitline?.error}
  visitorId={locals.splitline?.visitorId}
  experimentLabel={`Second page button · ${status}`}
  dashboardUrl={`${dashboard}/experiments/exp_pricing_cta`}
>
  <script id="splitline-state" type="application/json" set:html={JSON.stringify(tracker)} />
  <main class="mx-auto max-w-3xl px-4 pb-12">
    <Card>
      <CardHeader>
        <CardTitle class="text-3xl font-bold">{payload.headline}</CardTitle>
      </CardHeader>
      <CardContent class="grid gap-4">
        <p class="text-base leading-7">{payload.subhead}</p>
        {status === "paused" && !variant ? (
          <p class="text-sm text-muted-foreground">This experiment is paused, so new visitors are not enrolled. People who were already assigned keep their version.</p>
        ) : null}
        <Button href="/" data-splitline-goal>
          {payload.cta}
        </Button>
      </CardContent>
    </Card>
  </main>
</Base>
