---
import { Badge } from "../components/ui/badge";
import "../styles/global.css";

interface Props {
  title: string;
  variant?: string | null;
  preview?: boolean;
  error?: string | null;
  visitorId?: string;
  experimentLabel?: string;
  dashboardUrl: string;
}

const { title, variant, preview, error, visitorId, experimentLabel, dashboardUrl } = Astro.props;
const shortVisitor = visitorId ? visitorId.slice(0, 8) : "new";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content="Server-rendered experiment preview. The variant is chosen before HTML is sent." />
  </head>
  <body data-variant={variant ?? "control"} class="min-h-screen bg-background text-foreground antialiased">
    <div class="border-b border-border bg-secondary">
      <div class="mx-auto flex max-w-3xl flex-col gap-2 px-4 py-3 text-sm sm:flex-row sm:items-center sm:justify-between">
        <p class="flex flex-wrap items-center gap-2">
          <span class="font-bold">Experiment preview</span>
          <span>{experimentLabel ?? "No experiment on this page"}</span>
          {variant ? <Badge variant={preview ? "default" : "secondary"}>{preview ? "Preview" : "Assigned"} · {variant}</Badge> : null}
          <span class="font-mono text-xs text-muted-foreground">visitor {shortVisitor}</span>
        </p>
        <p class="flex flex-wrap gap-x-3 gap-y-1">
          <a href="/?sl_preview=homepage-hero:control">Control</a>
          <a href="/?sl_preview=homepage-hero:variant_b">Variant B</a>
          <a href="/?sl_preview=off">My assignment</a>
          <a href="/reset">New visitor</a>
          <a href={dashboardUrl}>Dashboard</a>
        </p>
      </div>
    </div>
    {error ? (
      <div class="border-b border-destructive bg-accent px-4 py-3 text-sm text-foreground">
        The experiment config didn’t load, so this page is showing the fallback copy. {error}
      </div>
    ) : null}
    <header class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-4 py-5">
      <a href="/" class="text-lg font-bold no-underline">Home</a>
      <nav class="flex items-center gap-4 text-sm">
        <a href="/">First page</a>
        <a href="/pricing">Second page</a>
      </nav>
    </header>
    <slot />
    <footer class="mt-16 border-t border-border">
      <div class="mx-auto flex max-w-3xl flex-col gap-3 px-4 py-8 text-sm text-muted-foreground sm:flex-row sm:items-center sm:justify-between">
        <p>The variant on this page was chosen before the HTML was sent.</p>
        <a href={dashboardUrl}>View the experiment</a>
      </div>
    </footer>
    <script>
      import "../scripts/track.ts";
    </script>
  </body>
</html>
